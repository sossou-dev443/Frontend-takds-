{
  "name": "taskd-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=768 node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=768 node_modules/next/dist/bin/next dev",
    "build": "tsc --noEmit && next build --webpack",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
